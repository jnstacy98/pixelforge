{
  "name": "pixelforge",
  "productName": "PixelForge",
  "version": "0.1.1",
  "description": "A Photoshop-inspired desktop image editor with layers, brushes and PSD support",
  "main": "electron/main.cjs",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "start": "npm run build && electron .",
    "app:dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron . --dev\"",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "test": "node tests/unit.mjs && node tests/e2e.mjs",
    "test:psd": "node tests/fetch-psd-fixtures.mjs && node tests/real-psd.mjs tests/.psd-fixtures --check tests/psd-budgets.json",
    "perf": "npm run build && node tests/perf.mjs"
  },
  "build": {
    "appId": "dev.pixelforge.app",
    "productName": "PixelForge",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    },
    "fileAssociations": [
      {
        "ext": "psd",
        "name": "Photoshop Document"
      },
      {
        "ext": "png",
        "name": "PNG Image"
      },
      {
        "ext": "jpg",
        "name": "JPEG Image"
      },
      {
        "ext": "webp",
        "name": "WebP Image"
      }
    ],
    "copyright": "Copyright © 2026 PixelForge contributors",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "icon": "build/icon.png",
    "publish": [
      {
        "provider": "github",
        "owner": "jnstacy98",
        "repo": "pixelforge",
        "releaseType": "release"
      }
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PixelForge",
      "license": "build/license.txt",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "menuCategory": false,
      "artifactName": "PixelForge-Setup-${version}.${ext}",
      "uninstallDisplayName": "PixelForge"
    },
    "portable": {
      "artifactName": "PixelForge-Portable-${version}.${ext}"
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.6",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "wait-on": "^9.5.1"
  },
  "dependencies": {
    "ag-psd": "^34.1.0",
    "electron-updater": "^6.8.11",
    "polygon-clipping": "^0.15.7",
    "utif2": "^4.1.0"
  }
}
